{
	"name": "Adw Lite",
	"author": "leoyd — based on Adwaita-for-Steam (tkashkin)",
	"description": "Steam in GNOME / libadwaita style, client and web pages. Lite version: system fonts, a few small scripts.",
	"version": "4.4-lite.3",
	"tags": [
		"Adwaita",
		"GNOME",
		"GTK",
		"libadwaita"
	],
	"github": {
		"owner": "leoyd",
		"repo_name": "steam-gnome-adwaita-millenium-theme"
	},
	"UseDefaultPatches": false,
	"Steam-WebKit": "webkit/webkit.min.css",
	"Patches": [
		{
			"MatchRegexString": "^Steam$",
			"TargetCss": "millennium/main.min.css",
			"TargetJs": [
				"millennium/has.js",
				"millennium/library.js"
			]
		},
		{
			"MatchRegexString": ".friendsui-container",
			"TargetCss": "millennium/adwaita.min.css"
		},
		{
			"MatchRegexString": ".ModalDialogPopup",
			"TargetCss": "millennium/adwaita.min.css"
		},
		{
			"MatchRegexString": ".FullModalOverlay",
			"TargetCss": "millennium/adwaita.min.css"
		},
		{
			"MatchRegexString": "Supernav$",
			"TargetCss": "millennium/menu.min.css"
		},
		{
			"MatchRegexString": "Menu$",
			"TargetCss": "millennium/menu.min.css"
		}
	],
	"Conditions": {
		"Color scheme": {
			"description": "Light or dark, for the client and the web pages",
			"tab": "Appearance",
			"section": "Colors",
			"default": "Dark",
			"values": {
				"Dark": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/scheme/dark.css"
					}
				},
				"Light": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/scheme/light.css"
					}
				},
				"System": {}
			}
		},
		"Palette": {
			"description": "Blue-tinted grays of GNOME 48+ or the neutral grays of earlier versions",
			"tab": "Appearance",
			"section": "Colors",
			"default": "GNOME 48+",
			"values": {
				"GNOME 48+": {},
				"Neutral gray (before GNOME 48)": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/scheme/gray.css"
					}
				}
			}
		},
		"Accent color": {
			"description": "GNOME accent colors",
			"tab": "Appearance",
			"section": "Colors",
			"default": "Blue",
			"values": {
				"Blue": {},
				"Teal": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/accent/teal.css"
					}
				},
				"Green": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/accent/green.css"
					}
				},
				"Yellow": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/accent/yellow.css"
					}
				},
				"Orange": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/accent/orange.css"
					}
				},
				"Red": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/accent/red.css"
					}
				},
				"Pink": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/accent/pink.css"
					}
				},
				"Purple": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/accent/purple.css"
					}
				},
				"Slate": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/accent/slate.css"
					}
				}
			}
		},
		"Window buttons": {
			"description": "Layout of the title bar buttons",
			"tab": "Appearance",
			"section": "Window",
			"default": "GNOME (close only)",
			"values": {
				"GNOME (close only)": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/layout/adwaita.css"
					}
				},
				"Minimize, maximize, close": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/layout/windows.css"
					}
				},
				"Left side (macOS)": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/layout/macos.css"
					}
				},
				"Pantheon": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/layout/pantheon.css"
					}
				}
			}
		},
		"What's New shelf": {
			"description": "\"What's New\" shelf at the top of the library",
			"tab": "Library",
			"section": "Home",
			"default": "Show",
			"values": {
				"Show": {},
				"Hide": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/extras/hide-whats-new.css"
					}
				}
			}
		},
		"Game list": {
			"description": "The left game list only appears when the mouse approaches the edge",
			"tab": "Library",
			"section": "Game list",
			"default": "Always visible",
			"values": {
				"Always visible": {},
				"On hover": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/extras/sidebar-hover.css"
					}
				}
			}
		},
		"Square icons": {
			"description": "Crops the game cover to a square on a game page",
			"tab": "Library",
			"section": "Game page",
			"default": "Yes",
			"values": {
				"Yes": {},
				"No": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/extras/uncrop-covers-in-details.css"
					}
				}
			}
		},
		"Lists limited to 6": {
			"description": "Game page: at most 6 friends per group; activity and community content by 6, with a \"Show more\" button (no endless loading while scrolling)",
			"tab": "Library",
			"section": "Game page",
			"default": "Yes",
			"values": {
				"Yes": {
					"TargetCss": {
						"affects": [
							"^Steam$"
						],
						"src": "options/extras/limits.css"
					},
					"TargetJs": {
						"affects": [
							"^Steam$"
						],
						"src": "millennium/limits.js"
					}
				},
				"No": {}
			}
		},
		"Background artwork": {
			"description": "Illustrated backgrounds of game pages (store and hubs). Custom profile backgrounds are always shown",
			"tab": "Web pages",
			"section": "Store and community",
			"default": "Hidden",
			"values": {
				"Hidden": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/extras/hide-web-backgrounds.css"
					}
				},
				"Shown": {}
			}
		},
		"Page address": {
			"description": "Shows the URL of store and community pages in the main window",
			"tab": "Web pages",
			"section": "Store and community",
			"default": "Hidden",
			"values": {
				"Hidden": {},
				"Shown": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/extras/show-url.css"
					}
				}
			}
		},
		"Micro-trailers": {
			"description": "Videos that play when hovering games in the store. When disabled, they are not downloaded at all (faster browsing)",
			"tab": "Web pages",
			"section": "Performance",
			"default": "Disabled",
			"values": {
				"Disabled": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/extras/no-microtrailers.css"
					},
					"TargetJs": {
						"affects": [
							".*"
						],
						"src": "millennium/no-microtrailers.js"
					}
				},
				"Enabled": {}
			}
		},
		"Login QR code": {
			"description": "Visibility of the QR code in the login window",
			"tab": "Sign-in",
			"section": "Login window",
			"default": "Show",
			"values": {
				"Show": {},
				"On hover": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/extras/hover-qr.css"
					}
				},
				"Hide": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "options/extras/hide-qr.css"
					}
				}
			}
		}
	}
}
